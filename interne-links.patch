 <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Wanneer staat mijn geld op mijn rekening?","acceptedAnswer":{"@type":"Answer","text":"Na goedkeuring van je gewerkte uren wordt je salaris automatisch verwerkt en staat het de volgende ochtend op je rekening."}},{"@type":"Question","name":"Kost dagbetaling mij iets extra?","acceptedAnswer":{"@type":"Answer","text":"Nee. Dagbetaling is een service van EXTRA, geen betaalde optie. Je ontvangt gewoon je volledige salaris conform cao."}},{"@type":"Question","name":"Krijg ik ook vakantiegeld en een loonstrook?","acceptedAnswer":{"@type":"Answer","text":"Ja. Dagbetaling verandert niets aan je rechten: je bent in loondienst, bouwt vakantiegeld op, bent verzekerd en ontvangt loonstroken zoals het hoort."}},{"@type":"Question","name":"Kan ik ook kiezen voor wekelijkse uitbetaling?","acceptedAnswer":{"@type":"Answer","text":"Zeker. Dagbetaling is optioneel — je kiest zelf de uitbetaalfrequentie die bij je past en kunt die later aanpassen."}},{"@type":"Question","name":"Geldt dagbetaling voor alle shifts?","acceptedAnswer":{"@type":"Answer","text":"Ja, dagbetaling geldt voor al het werk dat je via EXTRA doet: hotels, restaurants, events en catering."}}]}</script>
