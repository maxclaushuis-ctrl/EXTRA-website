ns-team" class="flex items-center gap-3 px-4 py-3 rounded-xl text-gray-700 hover:bg-purple-50 hover:text-purple-700 transition-all group/item"><div class="w-8 h-8 rounded-lg bg-purple-100 group-hover/item:bg-purple-200 flex items-center justify-center transition-colors shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users w-4 h-4 text-purple-600"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div><span class="text-[15px] font-semibold">Ons team</span></a></div></div></div></div><div class="hidden lg:flex items-center gap-3"><div class="relative"><button class="flex items-center gap-1.5 text-[13px] xl:text-[14px] font-bold px-3 xl:px-4 py-2 rounded-lg transition-all duration-200 text-white hover:bg-white/15" aria-label="Switch language"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe w-4 h-4 opacity-80"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg><span>NL</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-3 h-3 opacity-60 transition-transform duration-200 "><path d="m6 9 6 6 6-6"></path></svg></button><div class="absolute top-full right-0 pt-2 transition-all duration-200 opacity-0 -translate-y-2 pointer-events-none"><div class="bg-white rounded-2xl shadow-2xl shadow-purple-500/15 border border-purple-100/60 p-2 min-w-[160px]"><a href="/tijdelijk-horeca-personeel" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all bg-purple-50 text-purple-700"><span class="text-xl">🇳🇱</span><div><div class="text-[14px] font-bold">Nederlands</div><div class="text-[11px] text-gray-400">NL</div></div><div class="ml-auto w-2 h-2 bg-purple-600 rounded-full"></div></a><a href="/en" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all text-gray-600 hover:bg-purple-50 hover:text-purple-700"><span class="text-xl">🇬🇧</span><div><div class="text-[14px] font-bold">English</div><div class="text-[11px] text-gray-400">EN</div></div></a></div></div></div><a href="/personeelsaanvraag" class="inline-flex items-center gap-2 xl:gap-2.5 text-[13px] xl:text-[16px] font-black px-5 xl:px-8 py-2.5 xl:py-3.5 rounded-full transition-all duration-200 hover:-translate-y-0.5 hover:shadow-2xl whitespace-nowrap bg-white text-purple-700 border-2 border-white hover:shadow-white/30"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone w-4 h-4 xl:w-[18px] xl:h-[18px]"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>Personeel aanvragen</a></div><button class="lg:hidden p-3 rounded-xl transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center text-white hover:bg-white/15" aria-label="Menu openen" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu w-6 h-6"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg></button></div></div></nav><section class="relative pt-32 pb-16 lg:pt-44 lg:pb-24 overflow-hidden bg-gradient-to-br from-purple-950 via-[#1a0a3e] to-indigo-950"><div class="max-w-5xl mx-auto px-5 sm:px-8 relative z-10"><span class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 mb-6 text-purple-100 text-xs sm:text-sm font-semibold">Seizoen · piek · vervanging</span><h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white leading-[1.08] mb-6" style="font-family: Poppins, sans-serif;">Tijdelijk horeca personeel <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-300 via-pink-300 to-purple-200">precies wanneer je het nodig hebt</span></h1><p class="text-base sm:text-lg text-purple-100/85 leading-relaxed max-w-2xl mb-9">Flexibel personeel inhuren voor het seizoen, een piekperiode of onverwachte uitval. Je betaalt alleen gewerkte uren — zonder werkgeversrisico's, via EXTRA.</p><div class="flex flex-wrap gap-4"><a href="/personeelsaanvraag" class="inline-flex items-center gap-2 bg-white text-purple-950 font-bold px-7 py-3.5 rounded-full hover:shadow-2xl hover:shadow-white/20 transition-all hover:-translate-y-0.5">Vraag personeel aan <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-4 h-4"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><a href="/flexibel-horeca-personeel" class="inline-flex items-center gap-2 border border-white/30 text-white font-semibold px-7 py-3.5 rounded-full hover:bg-white/10 transition-colors">Flexibel horecapersoneel</a></div></div></section><section class="py-14 sm:py-20"><div class="max-w-3xl mx-auto px-5 sm:px-8 space-y-5"><p class="text-gray-700 leading-relaxed text-base sm:text-lg">De horeca is nooit vlak: het terrasseizoen explodeert bij de eerste zonnestralen, december loopt over en in januari is het stil. Tijdelijk personeel inhuren is dé manier om je loonkosten mee te laten bewegen met je omzet. Bij EXTRA schaal je per week — of zelfs per dag — op en af, zonder contracten die doorlopen als het stil is.</p><p class="text-gray-700 leading-relaxed text-base sm:text-lg">Ook bij ziekte, zwangerschapsverlof of een vertrokken kracht die nog niet is opgevolgd, overbrug je met tijdelijke medewerkers de periode zonder dat de kwaliteit inzakt. En anders dan bij losse oproepkrachten regelen wij de werving, screening, verloning en vervanging bij uitval.</p></div></section><section class="pb-14 sm:pb-20"><div class="max-w-5xl mx-auto px-5 sm:px-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-5"><div class="rounded-2xl border border-purple-100 bg-purple-50/50 p-6"><div class="w-9 h-9 rounded-xl bg-purple-600 flex items-center justify-center mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check w-5 h-5 text-white"><path d="M20 6 9 17l-5-5"></path></svg></div><h3 class="font-bold text-gray-900 mb-1.5">Betaal per gewerkt uur</h3><p class="text-sm text-gray-600 leading-relaxed">Geen vaste contracten of doorlopende kosten in stille weken.</p></div><div class="rounded-2xl border border-purple-100 bg-purple-50/50 p-6"><div class="w-9 h-9 rounded-xl bg-purple-600 flex items-center justify-center mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check w-5 h-5 text-white"><path d="M20 6 9 17l-5-5"></path></svg></div><h3 class="font-bold text-gray-900 mb-1.5">Seizoensproof</h3><p class="text-sm text-gray-600 leading-relaxed">Op tijd opgeschaald voor terras, december en het eventseizoen.</p></div><div class="rounded-2xl border border-purple-100 bg-purple-50/50 p-6"><div class="w-9 h-9 rounded-xl bg-purple-600 flex items-center justify-center mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check w-5 h-5 text-white"><path d="M20 6 9 17l-5-5"></path></svg></div><h3 class="font-bold text-gray-900 mb-1.5">Direct vervangen</h3><p class="text-sm text-gray-600 leading-relaxed">Uitval? Wij regelen vervanging, ook op korte termijn.</p></div><div class="rounded-2xl border border-purple-100 bg-purple-50/50 p-6"><div class="w-9 h-9 rounded-xl bg-purple-600 flex items-center justify-center mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check w-5 h-5 text-white"><path d="M20 6 9 17l-5-5"></path></svg></div><h3 class="font-bold text-gray-900 mb-1.5">Zonder risico</h3><p class="text-sm text-gray-600 leading-relaxed">Iedereen in loondienst bij EXTRA — geen Wet DBA-zorgen of naheffingen.</p></div></div></section><section class="pb-14 sm:pb-16"><div class="max-w-3xl mx-auto px-5 sm:px-8"><h2 class="text-2xl sm:text-3xl font-black text-gray-900 mb-4" style="font-family: Poppins, sans-serif;">Flexibel personeel inhuren: zo blijf je wendbaar</h2><div class="space-y-4"><p class="text-gray-700 leading-relaxed">Een gezonde flexibele schil ligt voor de meeste horecazaken rond de 20 tot 30 procent van de totale bezetting. Genoeg om pieken op te vangen en uitval te dekken, zonder dat je afhankelijk wordt van losse krachten. Onze klanten combineren een klein vast team met een vaste flexpoule van EXTRA-medewerkers die het bedrijf kennen — het beste van twee werelden: continuïteit én wendbaarheid.</p><p class="text-gray-700 leading-relaxed">Werkt een tijdelijke kracht zó goed dat je die vast in dienst wilt nemen? Dat juichen we toe; de voorwaarden daarvoor spreken we transparant met je af. Zo is tijdelijk personeel ook een risicoloze proefperiode voor vaste aanwas.</p></div></div></section><section class="pb-14 sm:pb-16"><div class="max-w-3xl mx-auto px-5 sm:px-8"><h2 class="text-2xl sm:text-3xl font-black text-gray-900 mb-4" style="font-family: Poppins, sans-serif;">Voor welke periodes kun je inhuren?</h2><div class="space-y-4"><p class="text-gray-700 leading-relaxed">Alles is mogelijk: een enkele shift, een paar weken rond de feestdagen, het volledige terrasseizoen of doorlopend elke vrijdag en zaterdag. Voor seizoensplanning geldt: hoe eerder je je verwachte bezetting deelt, hoe beter wij de juiste mensen voor je kunnen reserveren. Veel klanten plannen hun zomer- en decemberbezetting al maanden vooruit — dan staan de beste mensen voor jou klaar in plaats van bij de concurrent.</p></div></div></section><section class="pb-16 sm:pb-20"><div class="max-w-3xl mx-auto px-5 sm:px-8"><h2 class="text-2xl sm:text-3xl font-black text-gray-900 mb-6" style="font-family: Poppins, sans-serif;">Veelgestelde vragen</h2><div class="divide-y divide-gray-200 border-y border-gray-200"><details class="group py-4"><summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-gray-900">Wat is het verschil met een oproepkracht in eigen dienst?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 text-purple-600 transition-transform group-open:rotate-180 shrink-0 ml-4"><path d="m6 9 6 6 6-6"></path></svg></summary><p class="mt-3 text-gray-600 leading-relaxed">Bij EXTRA ligt het werkgeverschap bij ons: wij regelen werving, contracten, verloning, verzuim en vervanging. Jij betaalt alleen de gewerkte uren tegen een all-in tarief.</p></details><details class="group py-4"><summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-gray-900">Hoe lang kan ik tijdelijk personeel inhuren?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 text-purple-600 transition-transform group-open:rotate-180 shrink-0 ml-4"><path d="m6 9 6 6 6-6"></path></svg></summary><p class="mt-3 text-gray-600 leading-relaxed">Van één shift tot doorlopend, zonder minimumduur. Je schaalt per week op en af, passend bij je omzet en seizoen.</p></details><details class="group py-4"><summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-gray-900">Kan ik een tijdelijke kracht overnemen in vaste dienst?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 text-purple-600 transition-transform group-open:rotate-180 shrink-0 ml-4"><path d="m6 9 6 6 6-6"></path></svg></summary><p class="mt-3 text-gray-600 leading-relaxed">Ja, dat kan. We hanteren daar transparante afspraken voor — vraag ernaar bij je accountmanager.</p></details><details class="group py-4"><summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-gray-900">Wat gebeurt er bij ziekte van de tijdelijke kracht?<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 text-purple-600 transition-transform group-open:rotate-180 shrink-0 ml-4"><path d="m6 9 6 6 6-6"></path></svg></summary><p class="mt-3 text-gray-600 leading-relaxed">Dan regelen wij vervanging, vaak nog dezelfde dag. Het verzuimrisico ligt volledig bij EXTRA, niet bij jou.</p></details></div></div></section><section class="pb-16"><div class="max-w-3xl mx-auto px-5 sm:px-8"><h2 class="text-lg font-bold text-gray-900 mb-4">Lees ook</h2><ul class="flex flex-wrap gap-3"><li><a href="/horeca-personeel-inhuren" class="inline-block text-sm font-medium text-purple-700 bg-purple-50 border border-purple-200 rounded-full px-4 py-2 hover:bg-purple-100 transition-colors">Horeca personeel inhuren</a></li><li><a href="/flexibel-horeca-personeel" class="inline-block text-sm font-medium text-purple-700 bg-purple-50 border border-purple-200 rounded-full px-4 py-2 hover:bg-purple-100 transition-colors">Flexibel horecapersoneel</a></li><li><a href="/horeca-personeel-amsterdam" class="inline-block text-sm font-medium text-purple-700 bg-purple-50 border border-purple-200 rounded-full px-4 py-2 hover:bg-purple-100 transition-colors">Horeca personeel Amsterdam</a></li><li><a href="/onze-werkwijze" class="inline-block text-sm font-medium text-purple-700 bg-purple-50 border border-purple-200 rounded-full px-4 py-2 hover:bg-purple-100 transition-colors">Onze werkwijze</a></li></ul></div></section><section class="pb-20"><div class="max-w-5xl mx-auto px-5 sm:px-8"><div class="rounded-3xl bg-gradient-to-br from-purple-950 via-[#1a0a3e] to-indigo-950 px-8 py-12 sm:px-14 sm:py-16 text-center"><h2 class="text-2xl sm:text-4xl font-black text-white mb-3" style="font-family: Poppins, sans-serif;">Piek of gat in je planning?</h2><p class="text-purple-100/85 max-w-xl mx-auto mb-8">Vertel ons je periode en bezetting — wij doen binnen één werkdag een voorstel.</p><div class="flex flex-wrap justify-center gap-4"><a href="/personeelsaanvraag" class="inline-flex items-center gap-2 bg-white text-purple-950 font-bold px-7 py-3.5 rounded-full hover:shadow-2xl transition-all hover:-translate-y-0.5">Vraag personeel aan <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linec