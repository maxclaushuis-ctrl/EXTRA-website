 9 17l-5-5"></path></svg></div><span class="text-gray-700 font-medium text-sm sm:text-base">Fewer no-shows, because reliable staff actually show up</span></li><li class="flex items-start gap-3"><div class="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center flex-shrink-0 mt-0.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users w-4 h-4 text-purple-700"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div><span class="text-gray-700 font-medium text-sm sm:text-base">More continuity — fixed teams who know your venue</span></li><li class="flex items-start gap-3"><div class="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center flex-shrink-0 mt-0.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart w-4 h-4 text-purple-700"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg></div><span class="text-gray-700 font-medium text-sm sm:text-base">Staff who genuinely want to come back to your location</span></li></ul></div></div></div></div></section><section id="reliability" class="relative py-20 sm:py-28 lg:py-36 overflow-hidden bg-white"><div class="absolute inset-0 pointer-events-none overflow-hidden "><div class="absolute" style="left: 5%; top: 10%; width: 200px; height: 200px; transform: rotate(15deg); opacity: 0.07; mask-image: url(&quot;/assets/X_patroon_1771260543289-Db4pmQup.webp&quot;); mask-size: contain; mask-repeat: no-repeat; mask-position: center center; background-color: rgb(13