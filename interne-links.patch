ex items-center justify-center transition-all duration-200 hover:scale-110" aria-label="LinkedIn" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.12);"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin w-4 h-4 text-purple-300"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg></a></div></div><div><p class="text-xs font-bold uppercase tracking-widest text-purple-400 mb-5">Werkgevers</p><ul class="space-y-3"><li><a href="/personeelsaanvraag" class="text-sm text-purple-300/60 hover:text-white transition-colors hover:translate-x-0.5 inline-block">Personeel aanvragen</a></li><li><a href="/horeca-uitzendbureau-amsterdam-werkwijze" class="text-sm text-purple-300/60 hover:text-white transition-colors hover:translate-x-0.5 inline-block">Hoe het werkt</a></li><li><a href="/horeca-uitzendbureau-amsterdam" class="text-sm text-purple-300/60 hover:text-white transition-colors hover:translate-x-0.5 inline-block">Waarom EXTRA</a></li><li><a href="/horeca-personeel-amsterdam" class="text-sm text-purple-300/60 hover:text-white transition-colors hover:translate-x-0.5 inline-block">Horeca personeel</a></li><li><a href="/hotelpersoneel-inhuren" class="text-sm text-purple-300/60 hover:text-white transition-colors hover:translate-x-0.5 inline-block">Hotelpersoneel inhuren</a></li><li><a href="/eventpersoneel-inhuren" class="text-sm text-purple-300/60 hover:text-white transition-colors hover:translate-x-0.5 inline-block">Eventpersoneel inhuren</a></li><li><a href="/evenementen-personeel-inhuren" class="text-sm text-purple-300/60 hover:text-white transition-colors hover:translate-x-0.5 inline-block">Evenementen personeel inhuren</a></li><li><a href="/cateringper